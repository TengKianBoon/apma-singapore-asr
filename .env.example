# Copy this file to .env locally.
# Never commit the real .env file.

OPENAI_API_KEY=

# Safe defaults. Live use requires explicit gates and per-run confirmation.
DRY_RUN=true
CHINESE_SCRIPT_PREFERENCE=simplified
TRANSCRIPTION_ENGINE=mock
# Set automatically by Start_APMA.ps1 so Docker can show File Explorer paths.
APMA_HOST_JOBS_PATH=
ENABLE_LIVE_OPENAI_TRANSCRIPTION=false
ENABLE_LIVE_OPENAI_MINUTES=false
ENABLE_LIVE_OPENAI_RECONCILIATION=false
ENABLE_LIVE_GEMINI_TRANSCRIPTION=false
ENABLE_LIVE_QWEN_FILETRANS_TRANSCRIPTION=false
ENABLE_GEMINI_SPEAKER_ATTRIBUTION=false

# Transcription roles. The economy model remains the default.
OPENAI_MODEL=gpt-4o-mini-transcribe
OPENAI_DEFAULT_MODEL=gpt-4o-mini-transcribe
OPENAI_RECOMMENDED_MODEL=gpt-transcribe
ENABLE_PROVIDER_TIMESTAMPS=false
OPENAI_PREMIUM_MODEL=gpt-4o-transcribe
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize

# External provider credentials remain blank and environment-only.
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
ALIYUN_OSS_BUCKET=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_GENERATE_CONTENT_INLINE_AUDIO_LIMIT_BYTES=9437184
GEMINI_GENERATE_CONTENT_TIMEOUT_SECONDS=300
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QWEN_FILETRANS_MODEL=qwen-audio-3.0-asr-flash-filetrans
DASHSCOPE_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# data_uri is key-only and size-bounded; it was live-proven on short clips.
# private_oss supports Singapore/production for larger chunks and requires the OSS values above.
# dashscope_temporary needs only a Beijing-region Model Studio API key, but the
# provider-managed audio copy remains available for up to 48 hours and is for
# development/testing only. For that mode also use:
# DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_FILETRANS_STAGING_MODE=private_oss
QWEN_FILETRANS_DATA_URI_LIMIT_BYTES=9437184
DASHSCOPE_TEMPORARY_UPLOAD_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_FILETRANS_TEMPORARY_RETENTION_HOURS=48
QWEN_FILETRANS_DIARIZATION_ENABLED=true

# Configurable paid-provider planning estimates. Verify current account pricing before live use.
OPENAI_PRICE_GPT4O_MINI_TRANSCRIBE=0.003
OPENAI_PRICE_GPT_TRANSCRIBE=0.0045
OPENAI_PRICE_GPT4O_TRANSCRIBE=0.006
OPENAI_PRICE_GPT4O_TRANSCRIBE_DIARIZE=0.006
GEMINI_TRANSCRIBE_PRICE_PER_MINUTE_USD=0.005
QWEN_FILETRANS_PRICE_PER_MINUTE_USD=0.0021

MAX_COST_PER_JOB_USD=5.00
PAID_PROVIDER_COST_BUFFER_PERCENT=15
MAX_MINUTES_COST_PER_JOB_USD=2.00
OPENAI_RECONCILIATION_MODEL=gpt-5.6-sol
OPENAI_RECONCILIATION_REASONING_EFFORT=medium
OPENAI_RECONCILIATION_INPUT_PRICE_PER_1M=4.00
OPENAI_RECONCILIATION_OUTPUT_PRICE_PER_1M=20.00
MAX_RECONCILIATION_COST_PER_JOB_USD=2.00
OPENAI_MAX_COST_PER_CHUNK_USD=0.25
OPENAI_MAX_RETRIES=3
EXTERNAL_TRANSCRIPTION_MAX_RETRIES=3
EXTERNAL_TRANSCRIPTION_RETRY_BACKOFF_BASE=1
EXTERNAL_TRANSCRIPTION_RETRY_MAX_DELAY_SECONDS=60
# Long recordings are divided into bounded provider requests; source duration
# is not shortened. Base64/JSON routes use a conservative raw-audio envelope.
PROVIDER_SAFE_CHUNK_DURATION_SEC=300
GEMINI_GENERATE_CONTENT_INLINE_AUDIO_LIMIT_BYTES=9437184
SMART_CHUNKING_ENABLED=true
DEFAULT_CHUNK_DURATION_SEC=720
MIN_CHUNK_DURATION_SEC=300
MAX_CHUNK_DURATION_SEC=900
OVERLAP_SECONDS=12
CHUNK_BOUNDARY_SEARCH_WINDOW_SEC=90
SILENCE_NOISE_THRESHOLD_DB=-35
SILENCE_MIN_DURATION_SEC=0.7

# Commercial-pilot quote settings. Pricing only; live payments remain disabled.
COMMERCIAL_MODE=false
PAYMENTS_ENABLED=false
STRIPE_MODE=test
APMA_PRICE_BOOK_VERSION=apma-sg-pilot-2026-09-11-v1
APMA_QUOTE_VALID_MINUTES=30
APMA_GST_REGISTERED=false
APMA_GST_RATE=0.09
APMA_TARGET_AFTER_TAX_MARGIN=0.15
APMA_INCOME_TAX_RATE=0.17
APMA_USD_TO_SGD_RATE=1.40
APMA_PROVIDER_CONTINGENCY_RATE=0.25
APMA_REVIEWER_COST_PER_HOUR_SGD=35.00
